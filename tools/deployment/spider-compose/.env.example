# Optionally copy this file to `.env` to override Spider's embedded defaults.

# Deployment settings.
SPIDER_IMAGE_TAG=main
SPIDER_PULL_POLICY=always
SPIDER_RESTART_POLICY=unless-stopped

# Database settings.
SPIDER_DATABASE_IMAGE_REF=mariadb:10.11.16
SPIDER_DATABASE_NAME=spider-db
SPIDER_DATABASE_PORT=3306
SPIDER_DATABASE_ROOT_PASSWORD=spider-root-password
SPIDER_STORAGE_DB_PASSWORD=spider-password
SPIDER_STORAGE_DB_USERNAME=spider-user

# Storage settings.
# A complete storage image reference takes precedence over `SPIDER_IMAGE_TAG` when set.
# SPIDER_STORAGE_IMAGE_REF=ghcr.io/y-scope/spider/storage:main
SPIDER_STORAGE_LOG_LEVEL=INFO
SPIDER_STORAGE_PORT=50051
SPIDER_STORAGE_PUBLISHED_IP=127.0.0.1
SPIDER_STORAGE_PUBLISHED_PORT=50051
SPIDER_STORAGE_DB_MAX_CONNECTIONS=64
SPIDER_STORAGE_JOB_CACHE_GC_INTERVAL_SEC=30
SPIDER_STORAGE_JOB_CACHE_TERMINATED_JOB_RETENTION_SEC=300
SPIDER_STORAGE_TASK_INSTANCE_POOL_EXECUTION_MANAGER_STALE_CUTOFF_SEC=60
SPIDER_STORAGE_TASK_INSTANCE_POOL_GC_INTERVAL_SEC=30
SPIDER_STORAGE_TASK_INSTANCE_POOL_MESSAGE_CHANNEL_CAPACITY=128

# Scheduler settings.
# A complete scheduler image reference takes precedence over `SPIDER_IMAGE_TAG` when set.
# SPIDER_SCHEDULER_IMAGE_REF=ghcr.io/y-scope/spider/scheduler:main
SPIDER_SCHEDULER_LOG_LEVEL=INFO
SPIDER_SCHEDULER_PORT=50052
SPIDER_SCHEDULER_CONNECTION_POOL_SIZE=8
SPIDER_SCHEDULER_STOP_TIMEOUT_SEC=30
SPIDER_SCHEDULER_EM_REGISTRY_DEAD_EM_CUTOFF_SEC=30
SPIDER_SCHEDULER_EM_REGISTRY_LIVENESS_TRACKING_INTERVAL_MS=1000

# Scheduler policy settings.
# The `resource_group_round_robin` policy is enabled by default. To use a different policy, comment
# out the current policy setting and uncomment the desired one.
#SPIDER_SCHEDULER_POLICY=round_robin
SPIDER_SCHEDULER_POLICY=resource_group_round_robin

# Configurations for `round_robin` scheduler policy.
SPIDER_SCHEDULER_ROUND_ROBIN_ACTIVE_JOB_QUEUE_CAPACITY=16
SPIDER_SCHEDULER_ROUND_ROBIN_CLEANUP_READY_TASK_CAPACITY=256
SPIDER_SCHEDULER_ROUND_ROBIN_COMMIT_READY_TASK_CAPACITY=256
# `auto` sets the dispatch queue to four task assignments per CPU core.
SPIDER_SCHEDULER_ROUND_ROBIN_DISPATCH_QUEUE_CAPACITY=auto
SPIDER_SCHEDULER_ROUND_ROBIN_FINALIZING_JOB_EXPIRATION_TIMEOUT_SEC=300
SPIDER_SCHEDULER_ROUND_ROBIN_READY_TASK_CAPACITY=1048576
SPIDER_SCHEDULER_ROUND_ROBIN_STORAGE_POLL_TIMEOUT_MS=10
SPIDER_SCHEDULER_ROUND_ROBIN_TICK_INTERVAL_MS=5

# Configurations for `resource_group_round_robin` scheduler policy.
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_ACTIVE_JOB_LIST_CAPACITY=16
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_CLEANUP_READY_TASK_CAPACITY=256
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_COMMIT_READY_TASK_CAPACITY=256
# `auto` sets the dispatch queue to four task assignments per CPU core.
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_DISPATCH_QUEUE_CAPACITY=auto
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_FINALIZING_JOB_EXPIRATION_TIMEOUT_SEC=300
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_READY_TASK_CAPACITY=1048576
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_STORAGE_POLL_TIMEOUT_MS=10
SPIDER_SCHEDULER_RESOURCE_GROUP_ROUND_ROBIN_TICK_INTERVAL_MS=5

# Worker settings.
# A complete worker image reference takes precedence over `SPIDER_IMAGE_TAG` when set.
# SPIDER_WORKER_IMAGE_REF=ghcr.io/y-scope/spider/worker:main
# The `spider-worker` pool runs any resource group's tasks. Its number of workers is
# `SPIDER_WORKER_CPU_PERCENT` percent of the machine's CPU cores, rounded down and at least 1 (e.g.,
# 25 on 16 cores gives 4 workers). Setting `SPIDER_WORKER_COUNT` runs exactly that many workers and
# ignores the percent.
# The default of 100 uses every core, because the `spider-worker-dedicated` pool is disabled by
# default. When that pool is enabled, lower `SPIDER_WORKER_CPU_PERCENT` so that it and the dedicated
# pool's percent, counted once per replica, add up to at most 100 (e.g., 75 here and one replica at
# 25). Otherwise, workers outnumber the cores and their tasks slow each other down.
SPIDER_WORKER_CPU_PERCENT=100
#SPIDER_WORKER_COUNT=
SPIDER_WORKER_LOG_LEVEL=INFO
SPIDER_WORKER_CONNECTION_POOL_SIZE=4
SPIDER_WORKER_LIVENESS_SCHEDULER_HEARTBEAT_INTERVAL_SEC=1
SPIDER_WORKER_SCHEDULER_POLL_WAIT_MS=1000
SPIDER_WORKER_LIVENESS_STORAGE_HEARTBEAT_INTERVAL_SEC=1
SPIDER_WORKER_TASK_EXECUTOR_BIN_PATH=/usr/local/bin/spider-task-executor
SPIDER_WORKER_INHERITED_ENV=[]
SPIDER_WORKER_MAX_LOG_LINE_BYTES=65536
SPIDER_WORKER_PACKAGE_DIR=/opt/spider/packages

# Worker dedicated-pool settings.
# The `spider-worker-dedicated` pool runs only its resource group's tasks. It is disabled by default
# (0 replicas). To enable it, set a replica count > 0 and the external ID and password of an
# already-registered resource group, and set `SPIDER_SCHEDULER_POLICY` to a resource-group-aware
# scheduling policy (e.g. `resource_group_round_robin`).
# Each replica's number of workers comes from `SPIDER_DEDICATED_WORKER_CPU_PERCENT` or
# `SPIDER_DEDICATED_WORKER_COUNT`, in the same way as for the `spider-worker` pool. The percent
# applies to each replica (e.g., two replicas at 25 use 50 percent of the cores).
SPIDER_DEDICATED_WORKER_REPLICAS=0
SPIDER_DEDICATED_WORKER_CPU_PERCENT=25
#SPIDER_DEDICATED_WORKER_COUNT=
#SPIDER_DEDICATED_RESOURCE_GROUP_ID=
#SPIDER_DEDICATED_RESOURCE_GROUP_PASSWORD=
